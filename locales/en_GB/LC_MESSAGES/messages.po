msgid "rules.corporate_rules_label"
msgstr "Company guideline"

msgid "rules.corporate_rules_reason"
msgstr "We always use subcategories here and so no need to fill anything in."

msgid "rules.corporate_rules_solution"
msgstr "We always use subcategories here and so no need to fill anything in."

msgid "rules.americanism_label"
msgstr "Americanism"

msgid "rules.americanism_reason"
msgstr ""
"May not be understood by readers who do not have an English language "
"education."

msgid "rules.americanism_solution"
msgstr "Use a word in your text's language."

msgid "rules.pressure_label"
msgstr "Pressure"

msgid "rules.pressure_reason"
msgstr "Communicates pressure and thus is a sign of \"having to fit in\"."

msgid "rules.pressure_solution"
msgstr "Formulate at eye level, as you being an equal part of your team."

msgid "rules.visual_impairment_label"
msgstr "Visual Impairment"

msgid "rules.visual_impairment_reason"
msgstr ""
"Outdated, hidden or even discriminatory wording pigeonholing people with "
"visual impairment."

msgid "rules.visual_impairment_solution"
msgstr "Ask yourself \"What would I write if this person had full visibility?\""

msgid "rules.medical_condition_label"
msgstr "Medical Condition"

msgid "rules.medical_condition_reason"
msgstr ""
"Outdated, hidden or even discriminatory wording pigeonholing people with a "
"medical condition."

msgid "rules.medical_condition_solution"
msgstr "Ask yourself \"What would I write if this person was fully healthy?\""

msgid "rules.intellectual_impairment_label"
msgstr "Intellectual impairment"

msgid "rules.intellectual_impairment_reason"
msgstr ""
"Outdated, hidden or even discriminatory wording pigeonholing people with an "
"intellectual impairment."

msgid "rules.intellectual_impairment_solution"
msgstr ""
"Ask yourself \"What would I write if this person had their full mental "
"capacity?\""

msgid "rules.hearing_speech_impairment_label"
msgstr "Hearing and Speech Impairment"

msgid "rules.hearing_speech_impairment_reason"
msgstr ""
"Outdated, hidden or even discriminatory wording pigeonholing people with "
"hearing or speech impairment."

msgid "rules.hearing_speech_impairment_solution"
msgstr ""
"Ask yourself \"What would I write if this person had their full hearing and "
"speech capacity?\""

msgid "rules.mobility_impairment_label"
msgstr "Mobility Impairment"

msgid "rules.mobility_impairment_reason"
msgstr ""
"Outdated, hidden or even discriminatory wording pigeonholing people with a "
"mobility impairment."

msgid "rules.mobility_impairment_solution"
msgstr ""
"Ask yourself \"What would I write if this person was in full capacity of all"
" their limbs?\""

msgid "rules.mental_impairment_label"
msgstr "Mental impairment"

msgid "rules.mental_impairment_reason"
msgstr ""
"Outdated, hidden or even discriminatory wording pigeonholing people with a "
"mental impairment."

msgid "rules.mental_impairment_solution"
msgstr ""
"Ask yourself \"What would I write if this person was mentally fully  "
"healthy?\""

msgid "rules.ability_label"
msgstr "Ability"

msgid "rules.ability_reason"
msgstr ""
"Communicates exclusion by stating that a person's abilities are outside of "
"an assumed definition of \"normal\"."

msgid "rules.ability_solution"
msgstr ""
"Rephrase in a way that talks about the person's ability without implying "
"otherness or disability."

msgid "rules.formality_label"
msgstr "Formality"

msgid "rules.formality_reason"
msgstr ""
"Depending on the working environment, such formal wording can lead to more "
"distance and is not conducive to cooperation at eye level."

msgid "rules.formality_solution"
msgstr "Try to write as if you were writing to a friend."

