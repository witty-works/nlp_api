{
    "$id": "https://schemas.massdriver.cloud/schemas/bundles/nlp-api/schema-params.json",
    "$schema": "http://json-schema.org/draft-07/schema",
    "description": "NLP API Main app (receives requests, validates auth token, reads Redis config, dispatches to relevant language server)",
    "properties": {
        "args": {
            "description": "Arguments to pass to the entrypoint command of the container. If left unspecified, the container default will be used (referred to as 'command' in some container runtimes, such as Docker). Formatted as an array of strings so that 'exec' form is used.",
            "items": {
                "type": "string"
            },
            "title": "Arguments",
            "type": "array"
        },
        "command": {
            "description": "Command to execute as the entrypoint of the container. If left unspecified, the container default will be used (referred to as 'entrypoint' in some container runtimes, such as Docker). Formatted as an array of strings so that 'exec' form is used.",
            "items": {
                "type": "string"
            },
            "title": "Command",
            "type": "array"
        },
        "configuration": {
            "description": "Application specific configuration settings",
            "properties": {
                "aadb2c": {
                    "description": "AD B2C",
                    "properties": {
                        "domain": {
                            "type": "string"
                        },
                        "expected_scope": {
                            "type": "string"
                        },
                        "policy": {
                            "type": "string"
                        }
                    },
                    "title": "AADB2C",
                    "type": "object"
                },
                "api_docs": {
                    "description": "API Docs",
                    "properties": {
                        "auth_enabled": {
                            "type": "boolean"
                        },
                        "username": {
                            "type": "string"
                        }
                    },
                    "title": "API Docs",
                    "type": "object"
                },
                "app": {
                    "description": "App Settings",
                    "properties": {
                        "languages": {
                            "description": "JSON encoded array of languages enabled on this instance",
                            "title": "Languages",
                            "type": "string"
                        },
                        "text_max_length": {
                            "description": "Text Max Length",
                            "title": "Text Max Length",
                            "type": "integer"
                        }
                    },
                    "title": "App Settings",
                    "type": "object"
                },
                "context_checker": {
                    "description": "Context Checker",
                    "properties": {
                        "url": {
                            "type": "string"
                        }
                    },
                    "title": "Context Checker",
                    "type": "object"
                },
                "logging": {
                    "description": "Logging",
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "filename": {
                            "type": "string"
                        }
                    },
                    "title": "Logging",
                    "type": "object"
                },
                "sentry": {
                    "description": "Sentry",
                    "properties": {
                        "sample_rate": {
                            "type": "number"
                        },
                        "traces_sample_rate": {
                            "type": "number"
                        }
                    },
                    "title": "Sentry",
                    "type": "object"
                },
                "slack": {
                    "description": "Slack",
                    "properties": {
                        "organization_id": {
                            "type": "string"
                        }
                    },
                    "title": "Slack",
                    "type": "object"
                }
            },
            "title": "Configuration",
            "type": "object"
        },
        "image": {
            "properties": {
                "repository": {
                    "$md.immutable": true,
                    "description": "Container repository to use for this application.",
                    "title": "Repository",
                    "type": "string"
                },
                "tag": {
                    "$schema": "http://json-schema.org/draft-07/schema",
                    "default": "latest",
                    "description": "Docker image tag",
                    "message": {
                        "pattern": "Tag may contain at most 128 characters composed of lowercase and uppercase letters, digits, underscores, periods and dashes. Tag must start with an alphanumeric character."
                    },
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$",
                    "title": "Image Tag",
                    "type": "string"
                }
            },
            "required": [
                "repository",
                "tag"
            ],
            "title": "Container Image",
            "type": "object"
        },
        "ingress": {
            "dependencies": {
                "enabled": {
                    "oneOf": [
                        {
                            "properties": {
                                "enabled": {
                                    "const": false
                                }
                            }
                        },
                        {
                            "properties": {
                                "enabled": {
                                    "const": true
                                },
                                "host": {
                                    "description": "The hostname which this application should be accessable on, such as www.example.com. You must own this domain and have it associated with this kubernetes cluster if you would like automatic DNS record and SSL certificate management.",
                                    "message": {
                                        "pattern": "Hostname should consist of letters, numbers, periods and hyphens, such as www.example.com"
                                    },
                                    "pattern": "^(([a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9\\-]*[a-zA-Z0-9])\\.)*([A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9\\-]*[A-Za-z0-9])$",
                                    "title": "HTTP Hostname",
                                    "type": "string"
                                },
                                "path": {
                                    "default": "/",
                                    "description": "The HTTP path which, when appended to the host above, this application will serve traffic on",
                                    "message": {
                                        "pattern": "Must begin with a '/' and be a valid HTTP endpoint"
                                    },
                                    "pattern": "^\\/.*$",
                                    "title": "HTTP Path",
                                    "type": "string"
                                }
                            },
                            "required": [
                                "host",
                                "path"
                            ]
                        }
                    ]
                }
            },
            "description": "Configure the application for public internet accessibility",
            "properties": {
                "enabled": {
                    "default": false,
                    "title": "Enable Public Internet Access",
                    "type": "boolean"
                }
            },
            "title": "Ingress",
            "type": "object"
        },
        "namespace": {
            "$schema": "http://json-schema.org/draft-07/schema",
            "default": "default",
            "description": "Application will be deployed into this namespace. If the namespace doesn't exist, it will be created.",
            "message": {
                "pattern": "Name must follow RFC 1123: at most 63 characters, only lowercase alphanumeric characters or '-', and start and end with an alphanumeric character."
            },
            "pattern": "^(?:[a-z0-9]|[a-z0-9][a-z0-9-]{0,61}[a-z0-9])$",
            "title": "Kubernetes Namespace",
            "type": "string"
        },
        "port": {
            "$schema": "http://json-schema.org/draft-07/schema",
            "description": "The container port the application will listen on.",
            "maximum": 65535,
            "minimum": 0,
            "title": "Port",
            "type": "integer"
        },
        "replicas": {
            "dependencies": {
                "autoscalingEnabled": {
                    "oneOf": [
                        {
                            "properties": {
                                "autoscalingEnabled": {
                                    "const": false
                                },
                                "replicaCount": {
                                    "default": 1,
                                    "description": "Fixed number of replicas to constantly maintain",
                                    "minimum": 1,
                                    "title": "Number of Replicas",
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "replicaCount"
                            ]
                        },
                        {
                            "properties": {
                                "autoscalingEnabled": {
                                    "const": true
                                },
                                "maxReplicas": {
                                    "default": 10,
                                    "description": "Maximum number of replicas the autoscaler will provision, based on target resource utilization",
                                    "minimum": 1,
                                    "title": "Maximum Replicas",
                                    "type": "integer"
                                },
                                "minReplicas": {
                                    "default": 1,
                                    "description": "Minimum number of replicas the autoscaler will maintain, based on target resource utilization",
                                    "minimum": 1,
                                    "title": "Minimum Replicas",
                                    "type": "integer"
                                },
                                "targetCPUUtilizationPercentage": {
                                    "default": 80,
                                    "description": "The percentage of allocated CPU resources the autoscaler should target, based on the values specified in the 'Resources' section. If utilization rises sufficiently above this percentage, replicas will be added. If utilization drops sufficiently below this percentage, replicas will be removed.",
                                    "minimum": 1,
                                    "title": "Target CPU Utilization Percentage",
                                    "type": "integer"
                                }
                            },
                            "required": [
                                "minReplicas",
                                "maxReplicas",
                                "targetCPUUtilizationPercentage"
                            ]
                        }
                    ]
                }
            },
            "description": "Manage the number of concurrent replicas of your application",
            "properties": {
                "autoscalingEnabled": {
                    "default": false,
                    "description": "A Horizontal Pod Autoscaler will enable your application to automatically add or remove replicas based on resource utilization.",
                    "title": "Enable Horizontal Pod Autoscaling",
                    "type": "boolean"
                }
            },
            "title": "Replicas",
            "type": "object"
        },
        "resourceRequests": {
            "properties": {
                "cpu": {
                    "description": "The expected CPU cores required for this application. Fractional numbers are allowed (0.5 is one half of a CPU core).",
                    "minimum": 0.001,
                    "title": "CPU Cores",
                    "type": "number"
                },
                "memory": {
                    "description": "The expected Memory resources required for this application.",
                    "title": "Memory",
                    "type": "integer"
                }
            },
            "required": [
                "cpu",
                "memory"
            ],
            "title": "Resources",
            "type": "object"
        }
    },
    "required": [
        "namespace",
        "image",
        "resourceRequests",
        "replicas",
        "ingress"
    ],
    "title": "nlp-api"
}
