# TESTING=True
# MINIMUM_VERSION_WEB_EXT=1.30.1
# ALTERNATIVES_MAX_COUNT = 20

# REDIS_HOST=127.0.0.1
# REDIS_PORT=30000
# REDIS_VERIFY_SSL=FALSE

# TESTING_EMAIL = "foo@bar.com"
# TESTING_RULES = '{"id": "dashboard-user:17", "email": "foo@bar.com", "organization_id": "dashboard-team:9", "name": "Lukas Smith", "notifications": 3, "has_consented_to_mailing": true, "team_analytics": false, "config_hash": "foo", "config": { "gendered_roles_format": {"value": "inclusive_gender", "status": "force"}, "store_context": {"value": false, "status": "force"}, "show_inspiration_alternatives": {"value": true, "status": "force"}, "german_gender_ending": {"value": "/-in", "status": "force"}, "categories": { "plain_language": {"value": true, "status": "force"}, "plain_language_advanced": {"value": true, "status": "force"}, "orthography": {"value": true, "status": "force"}}},"false_positives": ["starke"],"term_replacements": {"ding" : {"alternatives": ["bar"], "lang": "en", "explanation": {"text": "some explanation", "icon": "💡", "url": "https://witty.works"}, "gravity": 1}, "run": {"lang": "en", "word_type": "v", "alternatives": ["walk"], "explanation": {"text": "some exaplanation", "icon": "", "url": "https://witty.works"}, "gravity": 1}}, "domains": {"type": "deny", "list": ["foo.bar"]}}'
# TESTING_ORGANIZATION_RULES = '{"id": "dashboard-team:9", "name": "Foo Bar", "plan": "witty_teams", "config_hash": "bar", "config": { "gendered_roles_format": {"value": "binary_gender", "status": "force"}, "store_context": {"value": false, "status": "force"}, "german_gender_ending": {"value": "/-in", "status": "force"}, "categories": { "plain_language_advanced": {"value": false, "status": "force"}, "orthography": {"value": true, "status": "force"}}},"false_positives": ["Führungskraft"],"term_replacements": {"foo": {"word_type": "=", "alternatives": ["bar (foo)"], "explanation": {"text": "here another explanation", "icon": null, "url": null}, "gravity": 1}, "UG FSK": {"alternatives": ["world"], "explanation": {"text": "explanation", "icon": "😃"}, "gravity": 1}}, "domains": {"type": "deny", "list": ["foo.bar", "hello.de"]}}'
# TESTING_RULES = '{"id": "dashboard-user:17", "email": "foo@bar.com", "organization_id": "dashboard-team:9", "name": "Lukas Smith", "notifications": 3, "has_consented_to_mailing": true, "team_analytics": false, "config_hash": "foo", "config": { "store_context": {"value": false, "status": "force"}, "show_inspiration_alternatives": {"value": true, "status": "force"}, "german_gender_ending": {"value": "/-in", "status": "force"}, "orthography": {"value": true, "status": "force"}},"false_positives": ["starke"],"term_replacements": {"ding" : {"alternatives": ["bar"], "lang": "en", "explanation": {"text": "some explanation", "icon": "💡", "url": "https://witty.works"}, "gravity": 1}, "run": {"lang": "en", "word_type": "v", "alternatives": ["walk"], "explanation": {"text": "some exaplanation", "icon": "", "url": "https://witty.works"}, "gravity": 1}}, "domains": {"type": "deny", "list": ["foo.bar"]}}'
# TESTING_ORGANIZATION_RULES = '{"id": "dashboard-team:9", "name": "Foo Bar", "plan": "witty_teams", "config_hash": "bar", "config": { "store_context": {"value": false, "status": "force"}, "german_gender_ending": {"value": "/-in", "status": "force"}, "orthography": {"value": true, "status": "force"}},"false_positives": ["Führungskraft"],"term_replacements": {"foo": {"word_type": "=", "alternatives": ["bar"], "explanation": {"text": "here another explanation", "icon": null, "url": null}, "gravity": 1}, "UG FSK": {"alternatives": ["world"], "explanation": {"text": "explanation", "icon": "😃"}, "gravity": 1}}, "domains": {"type": "deny", "list": ["foo.bar", "hello.de"]}}'

# It sets an environment variable for Intel’s OpenMP runtime (libiomp5) that tells it to ignore the error when multiple copies of the OpenMP library are loaded into the same process.
KMP_DUPLICATE_LIB_OK = True

LOGGING_ENABLED = True
LOGGING_CONFIG_LEVEL = DEBUG
LOGGING_CONFIG_FILENAME = stdout

# Default to the LG models, smaller models will lead to more false positives, or false negatives
# Transformer models acually provide even better results but are not supported due to the lack of NER data
# https://spacy.io/models
# Note: update pyproject.toml accordingly before installing the dependencies.
# MODELS = "{"en_core_web_lg","de_core_news_lg","fr_core_news_lg",}"

# ~~Optional Sentry.io Integration~~

# SENTRY_DSN=""
SENTRY_SAMPLE_RATE = 0.0
SENTRY_TRACES_SAMPLE_RATE = 1.0
SENTRY_PROFILES_SAMPLE_RATE = 1.0

# ~~Optional LanguageTool Integration~~

# LANGUAGETOOL_API= "http://localhost:8081/v2"
# LANGUAGETOOL_API = "https://api.languagetoolplus.com/v2"

# ~~Optional Context Checker Integration~~

# Use local SetFit models (recommended) or remote API
# CONTEXT_CHECKER_LOCAL = true

# Remote API configuration (JSON format)
# Format: {"en": {"url": "https://api.example.com/en", "api_key": "token"}, "de": {...}, "fr": {...}}
# CONTEXT_CHECKER = '{"en": {"url": "https://api.example.com/context-check", "api_key": "your-token"}}'

# ~~Optional AWS Integration~~

AWS_REGION_NAME = 'eu-central-1'
AWS_KEY = ""
AWS_SECRET_KEY = ""

# ~~Optional Slack Integration~~

# SLACK_SIGNING_SECRET = ""
# SLACK_BOT_TOKEN = ""
# SLACK_ORGANIZATION_ID = ""

# ~~Optional dashboard access tokens (Laravel Passport)~~

# The OAuth client id the dashboard issues extension tokens for, matched against
# the token's `aud` claim. Setting it enables this issuer.
# DASHBOARD_CLIENT_ID = ""
# Signing keys are read from {DASHBOARD_URL}/.well-known/jwks.json
# DASHBOARD_URL = "https://dashboard.example.com"
# DASHBOARD_JWKS_URL = ""
# Passport emits no `iss`, so leave this empty unless the dashboard adds one.
# DASHBOARD_ISSUER = ""
# DASHBOARD_EXPECTED_SCOPE = ""

# ~~Running without the dashboard~~

# Users authenticated by API key have no config synced from a dashboard. Without
# this they get a 403 from /v2.0/auth and every client reads that as signed out.
# DEFAULT_USER_CONFIG_ENABLED = true
# DEFAULT_USER_STORE_CONTEXT = true
# DEFAULT_USER_LLM_ALTERNATIVES = false
# Let a request set store_context and llm_alternatives for itself. A `force`
# rule in a synced config still wins.
# CLIENT_CONFIG_ENABLED = true

# Store API keys as an HMAC-SHA256 digest instead of verbatim. Keys created
# before this was set keep working via a plaintext fallback.
# API_KEY_HMAC_KEY = ""

# Whether a request has to resolve to a user before any text is checked.
# Off means the API answers anyone who can reach it.
# REQUIRE_AUTH = true

# Basic auth on /api_key, /user/configs, /organization/configs, /user/logs,
# /settings, /lt and /v1.0/prompt, using API_DOCS_USERNAME and
# API_DOCS_PASSWORD. On by default — local development is where you turn it off.
# MANAGEMENT_AUTH_ENABLED = false

# ~~Optional Azure AD B2C~~

# AADB2C_TENANT_ID = ""
# AADB2C_CLIENT_ID = ""
# AADB2C_EXPECTED_SCOPE = ""
# AADB2C_DOMAIN = ""
# AADB2C_POLICY = ""
# Fetch key information from https://{b2c_domain_name}.b2clogin.com/{b2c_domain_name}.onmicrosoft.com/{b2c_policy_name}/discovery/v2.0/keys
# AADB2C_RSA_KID = ""
# AADB2C_RSA_N = ""

# ~~Optional Microsoft Office SSO ~~

# https://login.microsoftonline.com/{tenant ID}/v2.0/.well-known/openid-configuration
#OFFICE_SSO_TENANT_ID = ""
#OFFICE_SSO_CLIENT_ID = ""
# use app id as the client id
# OFFICE_SSO_CLIENT_ID = ""
# OFFICE_SSO_EXPECTED_SCOPE = ""
# https://login.microsoftonline.com/{tenant ID}/discovery/v2.0/keys
# OFFICE_SSO_RSA_KID = ""
# OFFICE_SSO_RSA_N = ""
