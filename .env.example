# Copy to .env next to compose.yml. Every value here has a default in
# compose.yml; this file exists to pin the chosen deployment and to hold the
# secrets, which must not be committed.
#
# Chosen starting point: three languages, lg models, 2-4 workers, context
# checker off. See docs/deployment-sizing.md for what each knob costs.

# --- build time (change means `docker compose build`) -----------------------
SPACY_LANGS=en,de,fr
SPACY_MODEL_SIZE=lg

# --- runtime ----------------------------------------------------------------
# Start at 2 and raise to 4 once there is real traffic to measure against.
# Each extra worker is about 460 MiB, so 4 workers fit under API_MEM_LIMIT=8g.
WORKERS=2

# Off. Turning it on adds ~1.9 GiB and needs API_SHM_SIZE to stay at 2gb,
# because torch moves the model into /dev/shm.
CONTEXT_CHECKER_LOCAL=false

# --- LanguageTool (off for now) ---------------------------------------------
# Empty on purpose. The code default for this setting is LanguageTool's hosted
# API, so leaving it unset does not mean "no spell checking" - it means the
# text being checked is sent to api.languagetoolplus.com. Empty means neither.
#
# Off, the API returns no orthography findings (typos, punctuation) and none of
# the style and plain-language subcategories that come from LanguageTool. The
# gendered-language rules, which are the product, are unaffected.
#
# To turn it on:
#     docker compose --profile languagetool build
#     docker compose --profile languagetool up -d
# and set:
#     LANGUAGETOOL_API=http://languagetool:8010/v2
# Budget a further 3 GB of VM memory for it.
LANGUAGETOOL_API=

# The only thing to change when updating LanguageTool. It is the base image
# tag for languagetool/Dockerfile, which layers this project's ignore lists
# and config.properties on top - so the update keeps them. After changing it:
#     docker compose --profile languagetool build
# and run the test suite before trusting the result: LanguageTool retunes
# rules between releases and this project filters its output by rule id.
# 6.8 is the newest published tag as of 2026-09.
LT_VERSION=6.8

# --- memory limits ----------------------------------------------------------
# Measured idle: 3.94 GiB at 2 workers, 4.81 GiB at 4. 8g leaves room for
# request working memory and for raising WORKERS without editing this again.
API_MEM_LIMIT=8g
LT_MEM_LIMIT=3g
LT_HEAP_MAX=2g
REDIS_MEM_LIMIT=512m

# --- running without the dashboard ------------------------------------------
# The API mints its own key: both of these must be set, and the key is
# rewritten into Redis on every start. Clients send it as the `x-key` header -
# not Authorization, not X-API-KEY. A wrong header still returns 200 with an
# empty result set.
DEFAULT_API_KEY=change-me
DEFAULT_USER_EMAIL=ops@witty.works
# Without this, a caller Redis has never seen gets no usable config and every
# response is {"results": []}.
DEFAULT_USER_CONFIG_ENABLED=True
DEFAULT_CONFIG={"german_gender_ending":"de-e"}

# Leave the management endpoints authenticated.
MANAGEMENT_AUTH_ENABLED=True

# Nothing for free. Without this an unauthenticated request is answered with a
# 200 and an empty result set instead of being refused, which is friendlier to
# a signed-out client but means anyone who can reach the port can spend CPU.
REQUIRE_API_KEY=True
# The only routes that stay open. A client needs /health to be monitored and
# /v2.0/categories to render its UI before a key has been issued. Add
# "/slack/commands" here if Slack is enabled: it authenticates by signature
# and cannot send an API key.
PUBLIC_PATHS=["/health","/v2.0/categories"]

# --- ports ------------------------------------------------------------------
API_HOST_PORT=8080
LT_HOST_PORT=8210
